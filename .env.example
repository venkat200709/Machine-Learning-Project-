# ─────────────────────────────────────────────────────────────────────
# RiskRadar configuration
#
# Copy to `.env` and edit. Every value here is a *deployment* setting; the
# scientific constants (label schema, random seed, feature contract) live in
# src/riskradar/config.py and must never move between environments.
#
# Nothing in this file is required — the defaults give a working dashboard on
# a laptop with no setup at all.
# ─────────────────────────────────────────────────────────────────────

# ── Identity ─────────────────────────────────────────────────────────
# `production` switches on the readiness audit's strict rules and HSTS.
RISKRADAR_ENV=development
RISKRADAR_SERVICE_NAME=riskradar

# ── Persistence ──────────────────────────────────────────────────────
# SQLite by default. Note that SQLite needs POSIX file locking, which OneDrive,
# Dropbox and network shares do not provide — if the project folder is synced,
# the app falls back to your temp directory and logs a warning. Point this
# somewhere local, or use PostgreSQL, to silence it.
# RISKRADAR_DATABASE_URL=sqlite:///./data/riskradar.db
# RISKRADAR_DATABASE_URL=postgresql+psycopg://riskradar:changeme@localhost:5432/riskradar

RISKRADAR_PERSIST_PREDICTIONS=true
# Raw payloads are a location plus a timestamp — personal data in most
# jurisdictions. Off unless you have a lawful basis for storing them.
RISKRADAR_PERSIST_PAYLOADS=false
RISKRADAR_RETENTION_DAYS=90

# ── Security ─────────────────────────────────────────────────────────
# Off by default so a fresh clone just works. Turn on before exposing the port.
RISKRADAR_AUTH_ENABLED=false

# Break-glass admin credential. If unset, the admin routes are closed rather
# than open — an ephemeral key is generated that nobody holds.
# RISKRADAR_ADMIN_KEY=generate-a-long-random-string

# Without this, JWTs are signed with a per-process secret and every restart
# invalidates outstanding tokens.
# RISKRADAR_JWT_SECRET=another-long-random-string
RISKRADAR_JWT_TTL_MINUTES=720

# Pin to your dashboard's origin in production. A wildcard here plus
# credentials is rejected by browsers anyway.
RISKRADAR_CORS_ORIGINS=*

RISKRADAR_RATE_LIMIT_PER_MINUTE=240
RISKRADAR_RATE_LIMIT_BURST=60
RISKRADAR_MAX_UPLOAD_MB=50
RISKRADAR_MAX_BATCH_ROWS=50000

# ── Inference ────────────────────────────────────────────────────────
RISKRADAR_CACHE_ENABLED=true
RISKRADAR_CACHE_SIZE=2048
RISKRADAR_CACHE_TTL_SECONDS=300

# Conformal error rate: 0.10 means the true band is inside the returned set
# at least 90% of the time.
RISKRADAR_CONFORMAL_ALPHA=0.10

# Score live traffic with a challenger model in the background.
RISKRADAR_SHADOW_ENABLED=true

# ── Observability ────────────────────────────────────────────────────
RISKRADAR_METRICS_ENABLED=true
RISKRADAR_JSON_LOGS=false
RISKRADAR_LOG_LEVEL=INFO

# Rolling window of live predictions compared against the training reference.
RISKRADAR_DRIFT_WINDOW=500
RISKRADAR_DRIFT_PSI_WARN=0.10
RISKRADAR_DRIFT_PSI_ALERT=0.25
